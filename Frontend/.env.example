# ========================================================
# Code-Buddi - Frontend Client Environment Config
# ========================================================

# Unified API Gateway base URL. When using Nginx/Caddy reverse proxy (e.g. Docker or single domain),
# leave this empty ("") so requests route relatively (/api, /ai, /share).
# In multi-domain setups without a gateway, set the individual service URLs below.
VITE_API_GATEWAY_URL=

# Fallback / Direct Login service API URL (used if VITE_API_GATEWAY_URL is not set)
VITE_BACKEND_API_URL=http://localhost:5003

# Fallback / Direct Genai service API URL (used if VITE_API_GATEWAY_URL is not set)
VITE_GEMINI_API_URL=http://localhost:5001

# Fallback / Direct TempFile service API URL (used if VITE_API_GATEWAY_URL is not set)
VITE_TEMP_SHARE_URL=http://localhost:5002

# Google reCAPTCHA v3 public site key (registered in Google Cloud reCAPTCHA console)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Google OAuth 2.0 Web Client ID (matches Backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Client logger verbosity: 'DEBUG', 'INFO', 'WARN', 'ERROR'
VITE_LOG_LEVEL=INFO
