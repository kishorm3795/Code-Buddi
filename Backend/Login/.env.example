# ========================================================
# Code-Buddi - Backend Login Service Environment Config
# ========================================================

# Server port for the Login service (default: 5003)
PORT=5003

# Node execution environment: 'development', 'production', or 'test'
NODE_ENV=development

# MongoDB connection string (URI)
# Local Docker: mongodb://mongodb:27017/codebuddi
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/codebuddi?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/codebuddi

# HS512 secret key used to sign and verify JWT authentication tokens (min 64 chars recommended)
# Backends (Login, Genai, TempFile) MUST share the exact same JWT_SECRET
JWT_SECRET=your_jwt_secret_min_64_bytes_here_generate_with_openssl_rand_hex_64

# Google reCAPTCHA v3 secret key for bot verification on registration/login
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google OAuth 2.0 Web Client ID for verified Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# SMTP email service provider (e.g., 'gmail', 'SendGrid', or custom SMTP host)
OTP_EMAIL_SERVICE=gmail

# SMTP sender email address for delivering 6-digit verification OTPs
OTP_EMAIL_USER=your_email@gmail.com

# SMTP app password / token for the sender email account
OTP_EMAIL_PASS=your_email_app_password

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Log level for pino logger: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
