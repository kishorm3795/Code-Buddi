# ========================================================
# Code-Buddi - Backend Genai Service Environment Config
# ========================================================

# Server port for the Genai Flask microservice (default: 5001)
PORT=5001

# Flask execution environment: 'development' or 'production'
FLASK_ENV=development

# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model used for complex tasks (code generation, refactoring, test suite synthesis)
GEMINI_MODEL=gemini-2.5-pro

# Secondary/Faster Gemini model used for quick explanations and reviews
GEMINI_MODEL_1=gemini-2.5-flash

# HS512 secret key used to verify incoming JWT tokens (MUST match Login service's JWT_SECRET)
JWT_SECRET=your_jwt_secret_min_64_bytes_here_generate_with_openssl_rand_hex_64

# Google reCAPTCHA v3 secret key for bot prevention on AI generation endpoints
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
