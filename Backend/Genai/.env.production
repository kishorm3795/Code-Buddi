# ==========================================
# Backend - Genai (Production Environment)
# ==========================================
PORT=5001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_1=gemini-2.5-flash
JWT_SECRET=your_jwt_secret_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
ALLOWED_ORIGINS=https://yourdomain.com
FLASK_ENV=production

# Execution Engine Mode: 'sandboxed' (if Piston deployed) or 'simulated' (Gemini AI execution fallback)
EXECUTION_ENGINE=simulated
PISTON_URL=

# Managed Redis (Upstash / Redis Cloud) for rate limiting & quotas
REDIS_HOST=your-redis-host.example.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_SSL=true
EXECUTION_QUOTA_DAILY=100
