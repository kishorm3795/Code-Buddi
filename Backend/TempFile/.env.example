# ========================================================
# Code-Buddi - Backend TempFile Service Environment Config
# ========================================================

# Server port for the TempFile Flask microservice (default: 5002)
PORT=5002

# Flask / Application execution environment: 'development' or 'production'
FLASK_ENV=development
APP_ENV=development

# Public base URL of the TempFile service (used when generating shareable snippet URLs)
# Behind reverse proxy or production gateway, set to public URL (e.g. http://localhost:5002 or https://yourdomain.com/share)
TEMP_FILE_URL=http://localhost:5002

# Redis host address
# Local Docker: redis
# Local development: localhost
# Upstash / Managed: your-redis-cluster.upstash.io
REDIS_HOST=localhost

# Redis port number (default: 6379, or provider port like 6380)
REDIS_PORT=6379

# Redis password / auth token (leave blank if no password in local dev)
REDIS_PASSWORD=

# Enable SSL/TLS encryption for Redis connections (set 'true' for Upstash, AWS ElastiCache, Redis Cloud)
REDIS_SSL=false

# HS512 secret key used to verify incoming JWT tokens (MUST match Login service's JWT_SECRET)
JWT_SECRET=your_jwt_secret_min_64_bytes_here_generate_with_openssl_rand_hex_64

# Google reCAPTCHA v3 secret key for bot prevention on snippet uploads
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
