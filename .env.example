# ==============================================================================
# Code-Buddi - Master Root Environment Template
# ==============================================================================
# Note: In accordance with production best practices, each service maintains its
# own dedicated .env file:
#   - Backend/Login/.env.example
#   - Backend/Genai/.env.example
#   - Backend/TempFile/.env.example
#   - Frontend/.env.example
#
# For docker-compose or global setups, you can also populate this root .env file:
# ==============================================================================

# Shared JWT Secret (MUST match across Login, Genai, and TempFile)
# Generate a strong 64-character secret using: openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_random_hex_string

# Google reCAPTCHA v3 credentials
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Gemini AI API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_1=gemini-2.5-flash

# Email Verification (SMTP for Login service)
OTP_EMAIL_SERVICE=gmail
OTP_EMAIL_USER=your_email@gmail.com
OTP_EMAIL_PASS=your_email_app_password

# Redis Configuration (TempFile service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Allowed Frontend Origins (CORS)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173
